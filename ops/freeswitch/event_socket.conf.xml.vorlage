<configuration name="event_socket.conf" description="Socket Client">
  <!-- Gehaertet am 2026-08-25 (Audit 2). Vorher: listen-ip "::" (also alle
       Adressen, auch die oeffentliche), Passwort "ClueCon" (der
       FreeSWITCH-Default) und apply-inbound-acl auskommentiert. Nach aussen
       hat allein die ufw-Regel das abgedeckt — wer im Host-Netz Fuss
       fasst, haette die volle FreeSWITCH-Konsole gehabt, und der Container
       laeuft privileged. -->
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="127.0.0.1"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="__AUS_ENV_FREESWITCH_ESL_PASSWORD__"/>
    <param name="apply-inbound-acl" value="loopback.auto"/>
    <param name="stop-on-bind-error" value="true"/>
  </settings>
</configuration>
